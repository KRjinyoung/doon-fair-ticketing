  {
   "id": 2,
   "type": "timeseries",
   "title": "입력 · 처리 · DB 기록 속도 (건/초)",
   "description": "PoP 접수(입력) → Kafka 적재(매크로 통과분) → 중앙 판정 소비(처리) → DB 기록(묶음 저장)",
   "datasource": {
    "type": "prometheus",
    "uid": "koren-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 16,
    "h": 11
   },
   "targets": [
    {
     "expr": "sum(max by (pop_id) (rate(pop_seat_requests_total[$__rate_interval])))",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "koren-prometheus"
     },
     "legendFormat": "PoP 접수 (입력)"
    },
    {
     "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"seat-requests\"}[$__rate_interval]))",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "koren-prometheus"
     },
     "legendFormat": "Kafka 적재"
    },
    {
     "expr": "sum(rate(kafka_consumergroup_current_offset_sum{consumergroup=\"central-judge-group\",topic=\"seat-requests\"}[$__rate_interval]))",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "koren-prometheus"
     },
     "legendFormat": "중앙 판정 소비 (처리)"
    },
    {
     "expr": "sum(rate(pg_stat_database_tup_inserted{datname=\"ticketing\"}[$__rate_interval]))",
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "koren-prometheus"
     },
     "legendFormat": "DB 기록 (묶음 저장)"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "PoP 접수 (입력)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Kafka 적재"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "yellow"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "중앙 판정 소비 (처리)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "DB 기록 (묶음 저장)"
