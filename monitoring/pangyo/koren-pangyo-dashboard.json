      "title": "요청 처리율 (건/초)",
      "description": "각 PoP가 접수한 양, 중앙이 판정한 양, 결과가 전파된 양. 세 선이 겹쳐 흐르면 병목이 없는 것.",
      "datasource": {
        "type": "prometheus",
        "uid": "koren-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (pop_id) (rate(pop_seat_requests_total[$__rate_interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "koren-prometheus"
          },
          "legendFormat": "① {{pop_id}} 접수"
