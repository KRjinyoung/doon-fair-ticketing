  {
   "id": 5,
   "type": "stat",
   "title": "현재 구간 매크로 차단율",
   "description": "보이는 시간 범위 동안 PoP 에 들어온 요청 중 중앙으로 가지 않은 비율",
   "datasource": {
    "type": "prometheus",
    "uid": "koren-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 6,
    "h": 9
   },
   "targets": [
    {
     "expr": "100 * (1 - sum(max by (pop_id) (increase(pop_kafka_published_total[$__range]))) / clamp_min(sum(max by (pop_id) (increase(pop_seat_requests_total[$__range]))), 1))",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "koren-prometheus"
     },
     "legendFormat": ""
