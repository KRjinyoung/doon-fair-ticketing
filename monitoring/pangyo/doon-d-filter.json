  {
   "id": 1,
   "type": "row",
   "title": "같은 부하를 매크로 필터 OFF(monitor) 한 번, ON(enforce) 한 번 — 두 구간을 비교",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "PoP 접수 vs 중앙까지 넘어간 요청 (건/초)",
   "description": "필터 OFF 구간에서는 두 선이 겹치고, ON 구간에서는 매크로가 걸러져 아래 선이 내려간다.",
   "datasource": {
    "type": "prometheus",
    "uid": "koren-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "expr": "sum(max by (pop_id) (rate(pop_seat_requests_total[$__rate_interval])))",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "koren-prometheus"
     },
     "legendFormat": "PoP 접수"
    },
    {
     "expr": "sum(max by (pop_id) (rate(pop_kafka_published_total[$__rate_interval])))",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "koren-prometheus"
     },
     "legendFormat": "중앙으로 전달 (Kafka)"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "PoP 접수"
      },
      "properties": [
       {
        "id": "color",
        "value": {
